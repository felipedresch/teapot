# Cabeçalhos dos arquivos estáticos no Worker da Cloudflare (Workers Static
# Assets). Valem só para o que sai de dist/client; as páginas vêm do SSR
# (src/server.ts).
# O Vite põe o hash do conteúdo no nome de cada arquivo de /assets: um arquivo
# novo ganha outro nome, então o navegador pode guardar estes para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Os endereços workers.dev (produção, staging e previews) são cópia do site:
# fora dos buscadores.
https://:worker.galeria-felipe-dev.workers.dev/*
  X-Robots-Tag: noindex
